{
  "git": {
    "deploymentEnabled": {
      "gh-pages": false
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/doodates-emails?type=send-7d-reminder",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/doodates-emails?type=send-1d-validation",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/doodates-emails?type=batch-delete-post-tour",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/doodates-emails?type=promote-waitlist",
      "schedule": "0 2 * * *"
    }
  ]
}
